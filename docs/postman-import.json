	"item": [
		{
			"name": "01. Auth - Register Client",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"client@example.com\",\n    \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/register",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "auth", "register"]
				}
			}
		},
		{
			"name": "02. Auth - Login Client (Saves Tokens)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const res = pm.response.json();",
							"if (res.access_token) { pm.collectionVariables.set('accessToken', res.access_token); }",
							"if (res.refresh_token) { pm.collectionVariables.set('refreshToken', res.refresh_token); }"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"client@example.com\",\n    \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "auth", "login"]
				}
			}
		},
		{
			"name": "03. Auth - Login Admin (Saves Admin Token)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const res = pm.response.json();",
							"if (res.access_token) { pm.collectionVariables.set('adminAccessToken', res.access_token); }"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "auth", "login"]
				}
			}
		},
		{
			"name": "04. Users - Get Me",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/users/me",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "users", "me"]
				}
			}
		},
		{
			"name": "05. Admin Catalog - Create Service (Saves ID & Slug)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const res = pm.response.json();",
							"if (res.id) { pm.collectionVariables.set('serviceId', res.id); }",
							"if (res.slug) { pm.collectionVariables.set('serviceSlug', res.slug); }"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{adminAccessToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"lang\": \"ru\",\n    \"slug\": \"engineering-geology\",\n    \"title\": \"Инженерно-геологические изыскания\",\n    \"short_desc\": \"Комплексное изучение грунтов и подземных вод площадки строительства\",\n    \"full_desc\": \"Бурение разведочных скважин, статическое и динамическое зондирование, лабораторные испытания физико-механических свойств грунтов.\",\n    \"image_url\": \"/uploads/services/geology.jpg\",\n    \"standards\": [\"ГОСТ 25100-2020\", \"СП 47.13330.2016\"],\n    \"equipment\": [\"Буровая установка УРБ-2А2\", \"Комплект статического зондирования\"],\n    \"is_active\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/admin/services",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "admin", "services"]
				}
			}
		},
		{
			"name": "06. Admin Catalog - Create Service (Negative: Invalid Lang)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{adminAccessToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"lang\": \"de\",\n    \"slug\": \"test-service\",\n    \"title\": \"Тестовая услуга\",\n    \"short_desc\": \"Проверка валидации языка\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/admin/services",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "admin", "services"]
				}
			}
		},
		{
			"name": "07. Admin Catalog - Get Service By ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{adminAccessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/admin/services/{{serviceId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "admin", "services", "{{serviceId}}"]
				}
			}
		},
		{
			"name": "08. Admin Catalog - Update Service (PATCH)",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{adminAccessToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Инженерно-геологические изыскания (обновлено)\",\n    \"standards\": [\"ГОСТ 25100-2020\", \"СП 47.13330.2016\", \"ГОСТ 12248-2010\"],\n    \"is_active\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/admin/services/{{serviceId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "admin", "services", "{{serviceId}}"]
				}
			}
		},
		{
			"name": "09. Public Catalog - List Services By Lang",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/services?lang=ru",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "services"],
					"query": [
						{
							"key": "lang",
							"value": "ru"
						}
					]
				}
			}
		},
		{
			"name": "10. Public Catalog - Get Service By Slug",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/services/{{serviceSlug}}?lang=ru",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "services", "{{serviceSlug}}"],
					"query": [
						{
							"key": "lang",
							"value": "ru"
						}
					]
				}
			}
		},
		{
