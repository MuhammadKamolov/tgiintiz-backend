{
	"info": {
		"_postman_id": "tgiintiz-api-full-collection",
		"name": "TGIINTIZ API (Full: Auth & Surveys)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "POST 1. Register",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"register"
					]
				}
			},
			"response": []
		},
		{
			"name": "POST 2. Login (Auto-save tokens)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const res = pm.response.json();",
							"if (res.access_token) {",
							"    pm.collectionVariables.set('accessToken', res.access_token);",
							"}",
							"if (res.refresh_token) {",
							"    pm.collectionVariables.set('refreshToken', res.refresh_token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "GET 3. Get Me (Protected)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/users/me",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"users",
						"me"
					]
				}
			},
			"response": []
		},
		{
			"name": "POST 4. Create Survey (Success & Auto-save ID)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const res = pm.response.json();",
							"if (res.id) {",
							"    pm.collectionVariables.set('surveyId', res.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Инженерно-геологические изыскания объекта №1\",\n    \"description\": \"Бурение скважин глубиной до 15 метров с отбором проб грунта\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"surveys"
					]
				}
			},
			"response": []
		},
		{
			"name": "POST 5. Create Survey (Negative: Empty Title)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"\",\n    \"description\": \"Тест на отсечение пустых данных\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"surveys"
					]
				}
			},
			"response": []
		},
		{
			"name": "GET 6. List My Surveys (With Pagination)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys?page=1&page_size=10",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"surveys"
					],
					"query": [
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "page_size",
							"value": "10"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "GET 7. Get Survey By ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys/{{surveyId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"surveys",
						"{{surveyId}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "GET 8. Get Survey By ID (Negative: Not Found)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys/99999",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"surveys",
						"99999"
					]
				}
			},
			"response": []
		},
		{
			"name": "POST 9. Refresh Token (Auto-rotate)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const res = pm.response.json();",
							"if (res.access_token) {",
							"    pm.collectionVariables.set('accessToken', res.access_token);",
							"}",
							"if (res.refresh_token) {",
							"    pm.collectionVariables.set('refreshToken', res.refresh_token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"refresh_token\": \"{{refreshToken}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/refresh",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"refresh"
					]
				}
			},
			"response": []
		},
		{
			"name": "POST 10. Logout",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"refresh_token\": \"{{refreshToken}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/logout",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"logout"
					]
				}
			},
			"response": []
		},
		{
			"name": "GET 11. Admin: List Surveys (Pagination & Status)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/admin/surveys?status=&page=1&page_size=10",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"admin",
						"surveys"
					],
					"query": [
						{
							"key": "status",
							"value": "",
							"description": "Фильтр по статусу (например: pending, in_progress, completed, rejected). Оставь пустым для всех."
						},
						{
							"key": "page",
							"value": "1",
							"description": "Номер страницы (от 1)"
						},
						{
							"key": "page_size",
							"value": "10",
							"description": "Количество записей (1-100)"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "PATCH 12. Admin: Update Survey Status",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"status\": \"in_progress\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/admin/surveys/{{surveyId}}/status",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"admin",
						"surveys",
						"{{surveyId}}",
						"status"
					]
				}
			},
			"response": []
		},
		{
			"name": "DELETE 13. Admin: Delete Survey",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/admin/surveys/{{surveyId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"admin",
						"surveys",
						"{{surveyId}}"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "accessToken",
			"value": ""
		},
		{
			"key": "refreshToken",
			"value": ""
		},
		{
			"key": "surveyId",
			"value": "1"
		}
	]
