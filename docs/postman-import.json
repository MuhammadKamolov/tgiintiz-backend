		{
			"name": "19. Attachments - Upload File (Saves Attachment ID)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const res = pm.response.json();",
							"if (res.ID) { pm.collectionVariables.set('attachmentId', res.ID); }",
							"if (res.id) { pm.collectionVariables.set('attachmentId', res.id); }"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": []
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys/{{surveyId}}/attachments",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "surveys", "{{surveyId}}", "attachments"]
