{
	"info": {
		"_postman_id": "tgiintiz-backend-complete-suite",
		"name": "TGIINTIZ API (Complete Flow)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Auth - Register",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"client@example.com\",\n    \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/register",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "auth", "register"]
				}
			}
		},
		{
			"name": "02. Auth - Login (Saves Tokens)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const res = pm.response.json();",
							"if (res.access_token) { pm.collectionVariables.set('accessToken', res.access_token); }",
							"if (res.refresh_token) { pm.collectionVariables.set('refreshToken', res.refresh_token); }"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"client@example.com\",\n    \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "auth", "login"]
				}
			}
		},
		{
			"name": "03. Users - Get Me",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/users/me",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "users", "me"]
				}
			}
		},
		{
			"name": "04. Surveys - Create Survey (Saves ID)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const res = pm.response.json();",
							"if (res.id) { pm.collectionVariables.set('surveyId', res.id); }"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Инженерно-геологические изыскания объекта №1\",\n    \"location\": \"г. Душанбе, район Сино\",\n    \"description\": \"Бурение скважин глубиной до 15 метров с отбором проб грунта\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "surveys"]
				}
			}
		},
		{
			"name": "05. Surveys - Create Survey (Negative: Empty Title)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"\",\n    \"description\": \"Проверка валидации заголовка\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "surveys"]
				}
			}
		},
		{
			"name": "06. Surveys - List My Surveys (Pagination)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys?page=1&page_size=10",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "surveys"],
					"query": [
						{"key": "page", "value": "1"},
						{"key": "page_size", "value": "10"}
					]
				}
			}
		},
		{
			"name": "07. Surveys - Get By ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys/{{surveyId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "surveys", "{{surveyId}}"]
				}
			}
		},
		{
			"name": "08. Surveys - Get By ID (Negative: 404)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys/99999",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "surveys", "99999"]
				}
			}
		},
		{
			"name": "09. Attachments - Upload File (Saves Attachment ID)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const res = pm.response.json();",
							"if (res.ID) { pm.collectionVariables.set('attachmentId', res.ID); }",
							"if (res.id) { pm.collectionVariables.set('attachmentId', res.id); }",
							"if (res.FileURL) { pm.collectionVariables.set('fileUrl', res.FileURL); }",
							"if (res.file_url) { pm.collectionVariables.set('fileUrl', res.file_url); }"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": []
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys/{{surveyId}}/attachments",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "surveys", "{{surveyId}}", "attachments"]
				}
			}
		},
		{
			"name": "10. Attachments - List Files For Survey",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/surveys/{{surveyId}}/attachments",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "surveys", "{{surveyId}}", "attachments"]
				}
			}
		},
		{
			"name": "11. Attachments - Download Static File",
			"request": {
				"method": "GET",
				"url": {
					"raw": "{{baseUrl}}{{fileUrl}}",
					"host": ["{{baseUrl}}"],
					"path": ["{{fileUrl}}"]
				}
			}
		},
		{
			"name": "12. Attachments - Delete File (204 No Content)",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/attachments/{{attachmentId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "attachments", "{{attachmentId}}"]
				}
			}
		},
		{
			"name": "13. Auth - Refresh Token (Rotation)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const res = pm.response.json();",
							"if (res.access_token) { pm.collectionVariables.set('accessToken', res.access_token); }",
							"if (res.refresh_token) { pm.collectionVariables.set('refreshToken', res.refresh_token); }"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"refresh_token\": \"{{refreshToken}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/refresh",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "auth", "refresh"]
				}
			}
		},
		{
			"name": "14. Admin - List All Surveys (Status Filter)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/admin/surveys?status=&page=1&page_size=10",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "admin", "surveys"],
					"query": [
						{"key": "status", "value": ""},
						{"key": "page", "value": "1"},
						{"key": "page_size", "value": "10"}
					]
				}
			}
		},
		{
			"name": "15. Admin - Update Survey Status",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"status\": \"in_progress\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/admin/surveys/{{surveyId}}/status",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "admin", "surveys", "{{surveyId}}", "status"]
				}
			}
		},
		{
			"name": "16. Auth - Logout",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"refresh_token\": \"{{refreshToken}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/logout",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "auth", "logout"]
				}
			}
		}
	],
	"variable": [
		{"key": "baseUrl", "value": "http://localhost:8080"},
		{"key": "accessToken", "value": ""},
		{"key": "refreshToken", "value": ""},
		{"key": "surveyId", "value": "1"},
		{"key": "attachmentId", "value": "1"},
		{"key": "fileUrl", "value": "/uploads/test.png"}
	]
}