# Окружение приложения: local (цветной вывод в консоль + файл) или prod (JSON в stdout)
APP_ENV=local
LOG_LEVEL=info
LOG_FILE=app.log

# Настройки HTTP-сервера
SERVER_PORT=:8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=10s

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tgiintiz_db
DB_SSLMODE=disable

# JWT
JWT_SECRET=change_me_to_long_random_secret_key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0